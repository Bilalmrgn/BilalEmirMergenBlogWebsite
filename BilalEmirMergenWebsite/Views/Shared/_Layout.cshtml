@using Microsoft.EntityFrameworkCore
@inject BilalEmirMergenWebsite.Services.IPortfolioCacheService PortfolioCache
@{
    var isAdmin = Context.Request.Path.StartsWithSegments("/admin");
    var title = ViewData["Title"]?.ToString() ?? "Bilal Emir Mergen — Software Engineer";
    var description = ViewData["Description"]?.ToString() ?? "Software engineering portfolio, selected projects and technical writing.";
    var canonical = ViewData["Canonical"]?.ToString();
    var imagePath = ViewData["OgImage"]?.ToString() ?? "/og-portfolio-light.png";
    var ogImage = imagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? imagePath : $"{Context.Request.Scheme}://{Context.Request.Host}{imagePath}";
    var socials = isAdmin ? new List<BilalEmirMergenWebsite.Models.Social>() : await PortfolioCache.GetSocialsAsync();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="@description" />
    <meta name="robots" content="@(isAdmin ? "noindex, nofollow" : "index, follow, max-image-preview:large")" />
    @if (!string.IsNullOrWhiteSpace(canonical)) { <link rel="canonical" href="@canonical" /> }
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@title" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@ogImage" />
    <title>@title</title>
    <link rel="icon" href="~/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500;6..96,600;6..96,700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/portfolio-production.css" asp-append-version="true" />
    <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js" defer></script>
    @if (ViewData["JsonLd"] is string jsonLd) { <script type="application/ld+json">@Html.Raw(jsonLd)</script> }
</head>
<body class="@(isAdmin ? "admin-body" : "portfolio-body")">
    @if (!isAdmin)
    {
        <header class="mobile-cv-header"><a class="mobile-brand" href="/"><span>BM</span>Portfolio</a><button class="mobile-menu" type="button" data-drawer-toggle aria-label="Open navigation" aria-expanded="false"><i data-lucide="menu"></i></button></header>
    }
    <main class="@(isAdmin ? "admin-main" : "portfolio-main")">@RenderBody()</main>
    @if (!isAdmin)
    {
        <footer class="portfolio-footer"><p>© @DateTime.UtcNow.Year Bilal Emir Mergen. Built with care in Istanbul.</p><div>@foreach (var social in socials) { <a href="@social.Url" target="@(social.Url.StartsWith("mailto:") ? null : "_blank")" rel="noreferrer">@social.Name</a> }</div></footer>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
