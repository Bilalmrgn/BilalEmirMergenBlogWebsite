@model BilalEmirMergenWebsite.Models.Article
@{
    ViewData["Title"] = Model.Title;

    // Helper functions to parse simple markdown to HTML strings in Razor
    string RenderMarkdown(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";

        var paragraphs = content.Split(new[] { "\n\n" }, StringSplitOptions.None);
        var result = new System.Text.StringBuilder();

        foreach (var p in paragraphs)
        {
            var trimmed = p.Trim();
            if (trimmed.StartsWith("# "))
            {
                result.AppendLine($"<h1 style=\"font-size: 2.2rem; margin: 2rem 0 1rem 0; color: #ffffff;\">{trimmed.Substring(2)}</h1>");
            }
            else if (trimmed.StartsWith("## "))
            {
                result.AppendLine($"<h2 style=\"font-size: 1.6rem; margin: 1.8rem 0 0.8rem 0; color: #ffffff;\">{trimmed.Substring(3)}</h2>");
            }
            else if (trimmed.StartsWith("### "))
            {
                result.AppendLine($"<h3 style=\"font-size: 1.3rem; margin: 1.5rem 0 0.6rem 0; color: #ffffff;\">{trimmed.Substring(4)}</h3>");
            }
            else if (trimmed.StartsWith("- ") || trimmed.StartsWith("* "))
            {
                result.AppendLine("<ul style=\"padding-left: 1.5rem; margin-bottom: 1.25rem;\">");
                var items = trimmed.Split('\n');
                foreach (var item in items)
                {
                    var cleanItem = item.Trim();
                    if (cleanItem.Length > 2)
                    {
                        result.AppendLine($"<li style=\"margin-bottom: 0.5rem;\">{cleanItem.Substring(2)}</li>");
                    }
                }
                result.AppendLine("</ul>");
            }
            else
            {
                result.AppendLine($"<p style=\"margin-bottom: 1.25rem;\">{trimmed.Replace("\n", "<br/>")}</p>");
            }
        }

        return result.ToString();
    }
}

<article>
    <a href="/" class="back-link">
        <i data-lucide="arrow-left" style="width: 16px; height: 16px; display: inline-block; vertical-align: middle; margin-right: 4px;"></i> 
        Geri Dön
    </a>

    <header class="post-header">
        <div class="post-meta">
            <span>@Model.CreatedAt.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</span>
            <span>•</span>
            <span>
                <i data-lucide="eye" style="width: 16px; height: 16px; display: inline-block; vertical-align: middle; margin-right: 4px;"></i> 
                @Model.Views okuma
            </span>
        </div>
        <h1 class="post-title">@Model.Title</h1>
        <p style="font-size: 1.2rem; color: var(--text-muted); font-style: italic;">@Model.Summary</p>
    </header>

    @if (!string.IsNullOrEmpty(Model.CoverImage))
    {
        <img src="@Model.CoverImage" alt="@Model.Title" class="post-cover" onerror="this.style.display='none';" />
    }

    <div class="post-body">
        @Html.Raw(RenderMarkdown(Model.Content))
    </div>
</article>
