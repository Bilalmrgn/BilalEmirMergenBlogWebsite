<!-- Projects Showcase -->
<section id="projects" class="section-container" style="border-top: 1px solid var(--card-border);">
    <h2 class="section-title">
        <i data-lucide="briefcase" style="color: var(--secondary); margin-right: 8px;"></i>
        Projelerim
    </h2>

    @if (!Model.Projects.Any())
    {
        <div class="glass-card" style="text-align: center; padding: 3rem;">
            <p style="color: var(--text-muted);">Henüz proje eklenmemiş.</p>
        </div>
    }
    else
    {
        <div class="projects-grid">
            @foreach (var proj in Model.Projects)
            {
                <div class="glass-card project-card">
                    @if (!string.IsNullOrEmpty(proj.ImageUrl))
                    {
                        <img src="@proj.ImageUrl" alt="@proj.Title" class="project-image" onerror="this.src='https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=600&q=80'" />
                    }
                    <h3 class="project-title">@proj.Title</h3>
                    <p class="project-desc">@StripHtml(proj.Description)</p>
                    
                    @if (proj.Tags != null && proj.Tags.Any())
                    {
                        <div class="project-tags">
                            @foreach (var tag in proj.Tags)
                            {
                                <span class="project-tag">@tag</span>
                            }
                        </div>
                    }

                    <a href="javascript:void(0)" onclick="openProjectModal('@proj.Id', '@JavaScriptStringEncode(proj.Title)', '@JavaScriptStringEncode(proj.Description)', '@JavaScriptStringEncode(proj.ImageUrl)', '@JavaScriptStringEncode(proj.ProjectUrl)', '@JavaScriptStringEncode(string.Join(", ", proj.Tags ?? new List<string>()))')" class="project-link">
                        Detayları İncele <i data-lucide="arrow-right" style="width: 14px; height: 14px;"></i>
                    </a>
                </div>
            }
        </div>
    }
</section>

<!-- Blog Section -->
<section class="section-container" style="border-top: 1px solid var(--card-border);">
    <h2 class="section-title">
        <i data-lucide="book-open" style="color: var(--primary); margin-right: 8px;"></i>
        Yazılarım
    </h2>

    @if (!Model.Articles.Any())
    {
        <div class="glass-card" style="text-align: center; padding: 3rem;">
            <p style="color: var(--text-muted);">Henüz blog yazısı eklenmemiş.</p>
        </div>
    }
    else
    {
        <div class="blog-grid">
            @foreach (var post in Model.Articles)
            {
                <a href="/blog/@post.Slug" class="glass-card blog-card">
                    @if (!string.IsNullOrEmpty(post.CoverImage))
                    {
                        <img src="@post.CoverImage" alt="@post.Title" class="blog-card-image" onerror="this.src='https://images.unsplash.com/photo-1499750310107-5fef28a66643?auto=format&fit=crop&w=600&q=80'" />
                    }
                    <div class="blog-card-content">
                        <div class="blog-card-meta">
                            <span>@post.CreatedAt.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</span>
                        </div>
                        <h3 class="blog-card-title">@post.Title</h3>
                        <p class="blog-card-summary">@post.Summary</p>
                    </div>
                </a>
            }
        </div>
    }
</section>

<!-- Project Detail Modal -->
<div id="projectDetailModal" class="project-modal" style="display: none;">
    <div class="project-modal-backdrop" onclick="closeProjectModal()"></div>
    <div class="project-modal-content">
        <button class="project-modal-close" onclick="closeProjectModal()">&times;</button>
        <div class="project-modal-body">
            <img id="modal-project-image" src="" alt="" class="modal-project-image" style="display: none;" />
            <h2 id="modal-project-title" class="modal-project-title"></h2>
            <div id="modal-project-tags" class="project-tags" style="margin-top: 0.75rem; margin-bottom: 1.5rem;"></div>
            <div id="modal-project-desc" class="modal-project-desc"></div>
            
            <div class="modal-project-actions" style="display: flex; gap: 1rem; margin-top: 2rem;">
                <a id="modal-project-url" href="" target="_blank" rel="noopener noreferrer" class="btn-primary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                    Projeyi Ziyaret Et / GitHub
                </a>
                <button type="button" class="btn-secondary" onclick="closeProjectModal()">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openProjectModal(id, title, description, imageUrl, projectUrl, tagsString) {
            document.getElementById('modal-project-title').innerText = title;
            document.getElementById('modal-project-desc').innerHTML = description;
            
            var img = document.getElementById('modal-project-image');
            if (imageUrl) {
                img.src = imageUrl;
                img.style.display = 'block';
            } else {
                img.style.display = 'none';
            }
            
            var actionBtn = document.getElementById('modal-project-url');
            if (projectUrl) {
                actionBtn.href = projectUrl;
                actionBtn.style.display = 'inline-flex';
            } else {
                actionBtn.style.display = 'none';
            }
            
            var tagsContainer = document.getElementById('modal-project-tags');
            tagsContainer.innerHTML = '';
            if (tagsString) {
                var tags = tagsString.split(',').map(t => t.trim()).filter(t => t.length > 0);
                tags.forEach(tag => {
                    var span = document.createElement('span');
                    span.className = 'project-tag';
                    span.innerText = tag;
                    tagsContainer.appendChild(span);
                });
            }
            
            document.getElementById('projectDetailModal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
            
            if (window.lucide) {
                window.lucide.createIcons();
            }
        }
        
        function closeProjectModal() {
            document.getElementById('projectDetailModal').style.display = 'none';
            document.body.style.overflow = '';
        }
        
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeProjectModal();
            }
        });
    </script>
}

@functions {
    public static string StripHtml(string html)
    {
        if (string.IsNullOrEmpty(html)) return "";
        var plain = System.Text.RegularExpressions.Regex.Replace(html, "<.*?>", string.Empty);
        plain = System.Net.WebUtility.HtmlDecode(plain);
        if (plain.Length > 150) {
            plain = plain.Substring(0, 147) + "...";
        }
        return plain;
    }

    public static string JavaScriptStringEncode(string value)
    {
        if (string.IsNullOrEmpty(value)) return "";
        return System.Web.HttpUtility.JavaScriptStringEncode(value);
    }
}
