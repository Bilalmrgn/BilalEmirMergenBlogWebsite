@model BilalEmirMergenWebsite.Controllers.HomeViewModel
@using System.Text.RegularExpressions
@using BilalEmirMergenWebsite.Controllers
@functions {
    string Key(string value) => Regex.Replace(value.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');
    IReadOnlyList<string> Lines(string value) => value.Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    int ReadTime(string html) => Math.Max(1, (int)Math.Ceiling(Regex.Replace(html ?? string.Empty, "<[^>]+>", " ").Split(' ', StringSplitOptions.RemoveEmptyEntries).Length / 220d));
}
@{
    var settings = Model.Settings;
    var about = Model.AboutSections.FirstOrDefault() ?? new BilalEmirMergenWebsite.Models.AboutSection();
    var profileImage = settings.ProfileImage.Or(about.ImageUrl);
    var categories = Model.Projects.Select(item => item.CategoryEn.Or(item.Status).Or("Other")).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
}

<div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
<div class="drawer-backdrop" data-drawer-backdrop></div>

<div class="portfolio-shell">
    <aside class="portfolio-sidebar" aria-label="Profile and portfolio navigation">
        <a class="sidebar-mark" href="#about" aria-label="Back to introduction"><span>BM</span><small>PORTFOLIO</small></a>
        <div class="sidebar-profile">
            @if (!string.IsNullOrWhiteSpace(profileImage))
            {
                <img src="@profileImage" alt="Portrait of @settings.FullName" width="116" height="116" fetchpriority="high" />
            }
            else
            {
                <div class="profile-fallback" aria-hidden="true">BM</div>
            }
            <h1>@settings.FullName.Or("Bilal Emir Mergen")</h1>
            <p>@settings.TitleEn.Or("Full Stack Software Engineer")</p>
        </div>
        <nav class="portfolio-nav" aria-label="Portfolio sections">
            <a class="active" href="#about"><span>01</span>About</a>
            @if (Model.Experiences.Any()) { <a href="#experience"><span>02</span>Experience</a> }
            @if (Model.Educations.Any()) { <a href="#education"><span>03</span>Education</a> }
            @if (Model.SkillCategories.Any()) { <a href="#skills"><span>04</span>Skills</a> }
            @if (Model.Projects.Any()) { <a href="#projects"><span>05</span>Projects</a> }
            @if (Model.Languages.Any()) { <a href="#languages"><span>06</span>Languages</a> }
            @if (Model.Articles.Any()) { <a href="#blog"><span>07</span>Blog</a> }
            <a href="#contact"><span>08</span>Contact</a>
        </nav>
        <div class="sidebar-footer">
            <div class="sidebar-socials">
                @foreach (var social in Model.Socials)
                {
                    <a href="@social.Url" target="@(social.Url.StartsWith("mailto:") ? null : "_blank")" rel="noreferrer" aria-label="@social.Name"><i data-lucide="@social.Icon"></i></a>
                }
            </div>
            @if (settings.IsAvailable)
            {
                <p class="availability"><span></span>@settings.AvailabilityEn.Or("Available for selected work")</p>
            }
        </div>
    </aside>

    <div class="portfolio-content">
        <section class="portfolio-section about-section" id="about" aria-labelledby="about-title">
            <header class="section-heading" data-reveal>
                <p>@about.EyebrowEn.Or("Welcome")</p>
                <h2 id="about-title">@about.TitleEn.Or("About me")</h2>
            </header>
            <div class="about-layout">
                <div class="about-copy" data-reveal>
                    <p class="about-intro">@about.ShortTextEn.Or(settings.IntroEn)</p>
                    <div class="rich-content article-prose about-prose">@Html.Raw(about.DescriptionEn)</div>
                    <div class="about-actions">
                        @if (!string.IsNullOrWhiteSpace(settings.CvEnglishFile)) { <a class="primary-button" href="@settings.CvEnglishFile" target="_blank"><i data-lucide="download"></i>Download résumé</a> }
                        @if (!string.IsNullOrWhiteSpace(settings.Email)) { <a class="text-button" href="mailto:@settings.Email">Let’s talk<i data-lucide="arrow-up-right"></i></a> }
                    </div>
                </div>
                <dl class="about-facts" data-reveal>
                    @if (!string.IsNullOrWhiteSpace(settings.TitleEn)) { <div><dt>Role</dt><dd>@settings.TitleEn</dd></div> }
                    @if (!string.IsNullOrWhiteSpace(settings.LocationEn)) { <div><dt>Based in</dt><dd>@settings.LocationEn</dd></div> }
                    @if (!string.IsNullOrWhiteSpace(settings.Email)) { <div><dt>Email</dt><dd><a href="mailto:@settings.Email">@settings.Email</a></dd></div> }
                    <div><dt>Focus</dt><dd>Product engineering · Web systems</dd></div>
                </dl>
            </div>
        </section>

        @if (Model.Experiences.Any())
        {
            <section class="portfolio-section" id="experience" aria-labelledby="experience-title">
                <header class="section-heading" data-reveal><p>Professional journey</p><h2 id="experience-title">Work experience</h2></header>
                <div class="timeline-list">
                    @foreach (var item in Model.Experiences)
                    {
                        var bullets = Lines(item.BulletPointsEn.Or(item.BulletPointsTr));
                        <article class="timeline-entry" style="--timeline-accent:@item.TimelineColor.Or("#2F9CF4")" data-reveal>
                            <div class="timeline-dot">@if (!string.IsNullOrWhiteSpace(item.CompanyLogoUrl)) { <img src="@item.CompanyLogoUrl" alt="" loading="lazy" /> } else { <i data-lucide="@item.Icon"></i> }</div>
                            <div class="timeline-card">
                                <div class="timeline-card-head"><div><h3>@item.RoleEn.Or(item.RoleTr)</h3><p>@item.CompanyName@if (!string.IsNullOrWhiteSpace(item.LocationEn)) { <span> · @item.LocationEn</span> }</p></div><time>@item.StartDate.ToString("MMM yyyy") — @(item.IsCurrent ? "Present" : item.EndDate?.ToString("MMM yyyy"))</time></div>
                                @if (!string.IsNullOrWhiteSpace(item.DescriptionEn)) { <p>@item.DescriptionEn</p> }
                                @if (bullets.Count > 0) { <ul>@foreach (var bullet in bullets) { <li>@bullet</li> }</ul> }
                                <div class="tag-list">@foreach (var technology in item.Technologies.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)) { <span>@technology</span> }</div>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }

        @if (Model.Educations.Any())
        {
            <section class="portfolio-section" id="education" aria-labelledby="education-title">
                <header class="section-heading" data-reveal><p>Academic path</p><h2 id="education-title">Education</h2></header>
                <div class="timeline-list education-timeline">
                    @foreach (var item in Model.Educations)
                    {
                        <article class="timeline-entry" style="--timeline-accent:@item.TimelineColor.Or("#9B6CF0")" data-reveal>
                            <div class="timeline-dot">@if (!string.IsNullOrWhiteSpace(item.LogoUrl)) { <img src="@item.LogoUrl" alt="" loading="lazy" /> } else { <i data-lucide="graduation-cap"></i> }</div>
                            <div class="timeline-card">
                                <div class="timeline-card-head"><div>@if (item.IsExchangeProgram) { <span class="card-badge">Exchange program</span> }<h3>@item.DegreeEn.Or(item.FieldEn)</h3><p>@item.SchoolName@if (!string.IsNullOrWhiteSpace(item.LocationEn)) { <span> · @item.LocationEn</span> }</p></div><time>@item.StartDate?.ToString("MMM yyyy") — @(item.IsCurrent ? "Present" : item.EndDate?.ToString("MMM yyyy"))</time></div>
                                @if (!string.IsNullOrWhiteSpace(item.FieldEn) && item.FieldEn != item.DegreeEn) { <strong class="timeline-field">@item.FieldEn</strong> }
                                @if (!string.IsNullOrWhiteSpace(item.DescriptionEn)) { <p>@item.DescriptionEn</p> }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }

        @if (Model.SkillCategories.Any())
        {
            <section class="portfolio-section skills-section" id="skills" aria-labelledby="skills-title">
                <header class="section-heading" data-reveal><p>Technical toolkit</p><h2 id="skills-title">Skills & technologies</h2><span>Tools I use to turn thoughtful ideas into reliable products.</span></header>
                <div class="public-skill-groups">
                    @foreach (var category in Model.SkillCategories)
                    {
                        <section class="public-skill-group" style="--category-accent:@category.AccentColor.Or("#2F9CF4")">
                            <header data-reveal>
                                <span><i data-lucide="@category.Icon"></i></span>
                                <div><h3>@category.NameEn.Or(category.NameTr)</h3><p>@category.DescriptionEn.Or("Technologies used in production work")</p></div>
                                <small>@category.Skills.Count @(category.Skills.Count == 1 ? "technology" : "technologies")</small>
                            </header>
                            <div class="public-skill-grid">
                                @foreach (var skill in category.Skills)
                                {
                                    <article class="public-skill-card" data-reveal>
                                        <partial name="_TechnologyIcon" model='new TechnologyIconViewModel(skill.Name, skill.Icon, skill.IconType, skill.IconUrl, skill.BrandColor, 58)' />
                                        <h4>@skill.Name</h4>
                                        <p>@skill.DescriptionEn.Or(skill.DescriptionTr).Or(category.NameEn)</p>
                                    </article>
                                }
                            </div>
                        </section>
                    }
                </div>
            </section>
        }

        @if (Model.Projects.Any())
        {
            <section class="portfolio-section" id="projects" aria-labelledby="projects-title">
                <header class="section-heading" data-reveal><p>Selected work</p><h2 id="projects-title">Projects</h2></header>
                <div class="project-filters" role="group" aria-label="Filter projects" data-reveal><button class="active" type="button" data-project-filter="all" aria-pressed="true">All</button>@foreach (var category in categories) { <button type="button" data-project-filter="@Key(category)" aria-pressed="false">@category</button> }</div>
                <div class="project-grid">
                    @foreach (var item in Model.Projects)
                    {
                        var title = item.TitleEn.Or(item.Title);
                        var category = item.CategoryEn.Or(item.Status).Or("Other");
                        <article class="project-card" data-project-category="@Key(category)" data-reveal>
                            <a class="project-image" href="/en/projects/@item.Slug" aria-label="View @title case study">@if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img src="@item.ImageUrl" alt="@title project preview" loading="lazy" /> } else { <div><i data-lucide="code-2"></i><span>@title</span></div> }@if (item.IsFeatured) { <span class="featured-badge"><i data-lucide="star"></i>Featured</span> }</a>
                            <div class="project-card-body"><p class="project-category">@category</p><h3><a href="/en/projects/@item.Slug">@title</a></h3><p>@item.ShortDescriptionEn.Or(item.DescriptionEn.PlainSummary())</p><div class="tag-list">@foreach (var tag in item.Tags.Take(5)) { <span>@tag</span> }</div><div class="project-links"><a href="/en/projects/@item.Slug">Case study<i data-lucide="arrow-up-right"></i></a>@if (!string.IsNullOrWhiteSpace(item.GitHubUrl)) { <a href="@item.GitHubUrl" target="_blank" rel="noreferrer" aria-label="GitHub"><i data-lucide="github"></i></a> }@if (!string.IsNullOrWhiteSpace(item.ProjectUrl)) { <a href="@item.ProjectUrl" target="_blank" rel="noreferrer" aria-label="Live demo"><i data-lucide="external-link"></i></a> }</div></div>
                        </article>
                    }
                </div>
            </section>
        }

        @if (Model.Languages.Any())
        {
            <section class="portfolio-section" id="languages" aria-labelledby="languages-title">
                <header class="section-heading" data-reveal><p>Communication</p><h2 id="languages-title">Languages</h2></header>
                <div class="language-cards">
                    @foreach (var item in Model.Languages)
                    {
                        <article class="language-card" data-reveal><div><i data-lucide="@item.Icon.Or("languages")"></i></div><h3>@item.NameEn.Or(item.NameTr)</h3><p>@item.LevelEn.Or(item.LevelTr)</p>@if (!string.IsNullOrWhiteSpace(item.CefrLevel)) { <span>@item.CefrLevel</span> }</article>
                    }
                </div>
            </section>
        }

        @if (Model.Articles.Any())
        {
            <section class="portfolio-section" id="blog" aria-labelledby="blog-title">
                <header class="section-heading" data-reveal><p>Writing & ideas</p><h2 id="blog-title">Latest from the blog</h2></header>
                <div class="blog-grid">
                    @foreach (var item in Model.Articles)
                    {
                        var title = item.TitleEn.Or(item.Title);
                        var url = item.IsInternal ? $"/en/blog/{item.Slug}" : item.ExternalUrl;
                        <article class="blog-card" data-reveal>
                            <a class="blog-image" href="@url">
                                @if (!string.IsNullOrWhiteSpace(item.CoverImage)) { <img src="@item.CoverImage" alt="@title" loading="lazy" data-image-fallback /> }
                                <span class="image-placeholder"><i data-lucide="file-text"></i><small>Bilal Emir Mergen</small></span>
                            </a>
                            <div><div class="blog-meta"><span>@item.CategoryEn.Or("Engineering")</span><time>@(item.PublishedAt ?? item.CreatedAt).ToString("MMM d, yyyy") · @ReadTime(item.ContentEn.Or(item.Content)) min read</time></div><h3><a href="@url">@title</a></h3><p>@item.SummaryEn.Or(item.Summary)</p><a class="read-more" href="@url" target="@(!item.IsInternal ? "_blank" : null)">Read article<i data-lucide="arrow-right"></i></a></div>
                        </article>
                    }
                </div>
            </section>
        }

        <section class="contact-section" id="contact" aria-labelledby="contact-title" data-reveal>
            <p>Have a project or opportunity?</p>
            <h2 id="contact-title">@settings.ContactTitleEn.Or("Let’s build something useful.")</h2>
            <div class="contact-row"><p>@settings.ContactTextEn.Or("I’m always interested in thoughtful products, ambitious teams, and engineering challenges worth solving.")</p>@if (!string.IsNullOrWhiteSpace(settings.Email)) { <a class="primary-button" href="mailto:@settings.Email">Start a conversation<i data-lucide="arrow-up-right"></i></a> }</div>
            <div class="contact-socials">@foreach (var social in Model.Socials) { <a href="@social.Url" target="@(social.Url.StartsWith("mailto:") ? null : "_blank")" rel="noreferrer"><i data-lucide="@social.Icon"></i>@social.Name</a> }</div>
        </section>
    </div>
</div>

<button class="scroll-top" type="button" data-scroll-top aria-label="Back to top"><i data-lucide="arrow-up"></i></button>
