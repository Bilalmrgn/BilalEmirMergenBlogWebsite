                            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/express/express-original.svg" alt="Express" style="filter: invert(1);" />
                        </div>
                        <div class="skill-tile-name">Express</div>
                    </div>
                    <div class="skill-tile-item">
                        <div class="skill-tile-logo-wrapper" title="C#">
                            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/csharp/csharp-original.svg" alt="C#" />
                        </div>
                        <div class="skill-tile-name">C#</div>
                    </div>
                    <div class="skill-tile-item">
                        <div class="skill-tile-logo-wrapper" title="JavaScript">
                            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg" alt="JavaScript" />
                        </div>
                        <div class="skill-tile-name">JavaScript</div>
                    </div>
                    <div class="skill-tile-item">
                        <div class="skill-tile-logo-wrapper" title="TypeScript">
