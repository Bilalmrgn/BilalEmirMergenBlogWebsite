                        <div class="skill-tile-logo-wrapper" title="Node.js">
                            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original.svg" alt="Node.js" />
                        </div>
                        <div class="skill-tile-name">Node.js</div>
                    </div>
                    <div class="skill-tile-item">
