                </div>
                <div class="skills-tiles-grid">
                    <div class="skill-tile-item">
                        <div class="skill-tile-logo-wrapper" title="MySQL">
                            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mysql/mysql-original.svg" alt="MySQL" />
                        </div>
                        <div class="skill-tile-name">MySQL</div>
                    </div>
                    <div class="skill-tile-item">
                        <div class="skill-tile-logo-wrapper" title="MongoDB">
                            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mongodb/mongodb-original.svg" alt="MongoDB" />
                        </div>
                        <div class="skill-tile-name">MongoDB</div>
                    </div>
                    <div class="skill-tile-item">
                        <div class="skill-tile-logo-wrapper" title="Redis">
                            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/redis/redis-original.svg" alt="Redis" />
                        </div>
                        <div class="skill-tile-name">Redis</div>
                    </div>
                    <div class="skill-tile-item">
                        <div class="skill-tile-logo-wrapper" title="RabbitMQ">
                            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/rabbitmq/rabbitmq-original.svg" alt="RabbitMQ" />
