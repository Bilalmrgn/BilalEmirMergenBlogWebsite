                <div class="skills-group-title">
                    <i data-lucide="palette" style="width: 16px; height: 16px; color: var(--primary);"></i>
                    Frontend Technologies
                </div>
                <div class="skills-tiles-grid">
                    <div class="skill-tile-item">
                        <div class="skill-tile-logo-wrapper" title="Angular">
                            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/angular/angular-original.svg" alt="Angular" />
                        </div>
                        <div class="skill-tile-name">Angular</div>
                    </div>
                    <div class="skill-tile-item">
                        <div class="skill-tile-logo-wrapper" title="HTML5">
                            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original.svg" alt="HTML5" />
                        </div>
                        <div class="skill-tile-name">HTML5</div>
                    </div>
                    <div class="skill-tile-item">
                        <div class="skill-tile-logo-wrapper" title="CSS3">
