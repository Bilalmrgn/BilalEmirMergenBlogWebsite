@model BilalEmirMergenWebsite.Controllers.DashboardViewModel
@{
    var tab = Model.ActiveTab;
}
<aside class="cms-sidebar" data-admin-sidebar aria-label="Admin navigation">
    <div class="cms-brand">
        <a href="/admin/dashboard"><span>BM</span><strong>Portfolio Admin</strong></a>
        <button type="button" data-admin-sidebar-close aria-label="Close admin navigation"><i data-lucide="x"></i></button>
    </div>
    <nav class="cms-nav">
        <p>Workspace</p>
        <a class="@(tab == "overview" ? "active" : "")" href="/admin/dashboard?tab=overview"><i data-lucide="layout-dashboard"></i><span>Dashboard</span></a>
        <p>Content</p>
        @foreach (var item in new[] { ("about", "user-round", "About"), ("experience", "briefcase-business", "Experience"), ("education", "graduation-cap", "Education"), ("certificates", "badge-check", "Certificates"), ("skills", "blocks", "Skills"), ("projects", "folder-kanban", "Projects"), ("languages", "languages", "Languages"), ("articles", "newspaper", "Blog") })
        {
            <a class="@(tab == item.Item1 ? "active" : "")" href="/admin/dashboard?tab=@item.Item1"><i data-lucide="@item.Item2"></i><span>@item.Item3</span></a>
        }
        <p>Settings</p>
        <a class="@(tab == "settings" ? "active" : "")" href="/admin/dashboard?tab=settings"><i data-lucide="circle-user-round"></i><span>Profile & site</span></a>
        <a class="@(tab == "socials" ? "active" : "")" href="/admin/dashboard?tab=socials"><i data-lucide="share-2"></i><span>Social links</span></a>
    </nav>
    <div class="cms-sidebar-footer">
        <a href="/" target="_blank" rel="noreferrer"><i data-lucide="external-link"></i><span>View portfolio</span></a>
        <form method="post" action="/admin/logout">@Html.AntiForgeryToken()<button type="submit"><i data-lucide="log-out"></i><span>Logout</span></button></form>
    </div>
</aside>
<button class="cms-sidebar-backdrop" type="button" data-admin-sidebar-close aria-label="Close admin navigation"></button>
