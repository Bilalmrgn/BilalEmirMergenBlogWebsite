@model BilalEmirMergenWebsite.Controllers.DashboardViewModel
@{
    ViewData["Title"] = "Portfolio admin";
    var tab = Model.ActiveTab;
}

<div class="cms-shell">
    <partial name="_AdminSidebar" model="Model" />
    <div class="cms-workspace">
        <header class="cms-mobile-header"><button type="button" data-admin-sidebar-open aria-label="Open admin navigation"><i data-lucide="menu"></i></button><strong>Portfolio Admin</strong><a href="/en" target="_blank" rel="noreferrer" aria-label="Preview portfolio"><i data-lucide="external-link"></i></a></header>
        <div class="cms-content">
            <span class="admin-save-state" aria-live="polite" data-admin-status></span>
            @if (TempData["Success"] is not null) { <div class="cms-toast success" role="status"><i data-lucide="circle-check"></i><span>@TempData["Success"]</span><button type="button" data-dismiss-toast aria-label="Dismiss notification"><i data-lucide="x"></i></button></div> }
            @if (TempData["Error"] is not null) { <div class="cms-toast error" role="alert"><i data-lucide="circle-alert"></i><span>@TempData["Error"]</span><button type="button" data-dismiss-toast aria-label="Dismiss notification"><i data-lucide="x"></i></button></div> }
            <section class="cms-panel">
        @switch (tab)
        {
            case "overview": <partial name="_AdminOverview" model="Model" /> break;
            case "settings": <partial name="_AdminSettings" model="Model" /> break;
            case "about": <partial name="_AdminAbout" model="Model" /> break;
            case "experience": <partial name="_AdminExperience" model="Model" /> break;
            case "education": <partial name="_AdminEducation" model="Model" /> break;
            case "skills": <partial name="_AdminSkills" model="Model" /> break;
            case "projects": <partial name="_AdminProjects" model="Model" /> break;
            case "languages": <partial name="_AdminLanguages" model="Model" /> break;
            case "articles": <partial name="_AdminBlog" model="Model" /> break;
            case "socials": <partial name="_AdminSocials" model="Model" /> break;
            case "services": <partial name="_ServicesAdmin" model="Model" /> break;
            case "certificates": <partial name="_CertificatesAdmin" model="Model" /> break;
            default: <partial name="_AdminOverview" model="Model" /> break;
        }
            </section>
        </div>
    </div>
</div>
<dialog class="confirm-dialog" data-confirm-dialog aria-labelledby="confirm-title">
    <span><i data-lucide="trash-2"></i></span>
    <h2 id="confirm-title" data-confirm-title>Delete item?</h2>
    <p data-confirm-message>This item will be removed from the public portfolio.</p>
    <div><button class="cms-button secondary" type="button" data-confirm-cancel>Cancel</button><button class="cms-button danger" type="button" data-confirm-submit>Delete</button></div>
</dialog>
