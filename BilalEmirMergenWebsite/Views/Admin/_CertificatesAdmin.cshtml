@model BilalEmirMergenWebsite.Controllers.DashboardViewModel
@using BilalEmirMergenWebsite.Models
@using BilalEmirMergenWebsite.Controllers
@{ var item=Model.Certificates.FirstOrDefault(x=>x.Id==Model.EditId)??new Certificate(); }
<partial name="_AdminListHeader" model='("Certificates","Add certificate")'/>
<partial name="_OrderedTable" model='new OrderedTableViewModel("certificate",Model.Certificates.Select(x=>(x.Id,x.NameEn,x.Organization,x.SortOrder,x.IsActive)))'/>
<form class="admin-form open localized-admin-form" method="post" action="/admin/certificate/save">
@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@(Model.EditId is null?"":item.Id)"/>
<div class="admin-locale-tabs"><button type="button" class="active" data-locale-tab="en">English</button><button type="button" data-locale-tab="tr">Türkçe</button><button type="button" data-locale-tab="ar">العربية</button></div>
<div class="form-grid"><div class="locale-pane active" data-locale-pane="en"><div class="form-field"><label>Name</label><input class="form-control" name="NameEn" value="@item.NameEn"/></div><div class="form-field"><label>Description</label><textarea class="form-control" name="DescriptionEn">@item.DescriptionEn</textarea></div></div><div class="locale-pane" data-locale-pane="tr"><div class="form-field"><label>Ad</label><input class="form-control" name="NameTr" value="@item.NameTr"/></div><div class="form-field"><label>Açıklama</label><textarea class="form-control" name="DescriptionTr">@item.DescriptionTr</textarea></div></div><div class="locale-pane" data-locale-pane="ar" dir="rtl"><div class="form-field"><label>الاسم</label><input class="form-control" name="NameAr" value="@item.NameAr"/></div><div class="form-field"><label>الوصف</label><textarea class="form-control" name="DescriptionAr">@item.DescriptionAr</textarea></div></div><div class="form-field"><label>Organization</label><input class="form-control" name="Organization" value="@item.Organization"/></div><div class="form-field"><label>Issue date</label><input class="form-control" type="date" name="IssueDate" value="@item.IssueDate?.ToString("yyyy-MM-dd")"/></div><div class="form-field"><label>Expiration</label><input class="form-control" type="date" name="ExpirationDate" value="@item.ExpirationDate?.ToString("yyyy-MM-dd")"/></div><div class="form-field"><label>Credential ID</label><input class="form-control" name="CredentialId" value="@item.CredentialId"/></div><div class="form-field"><label>Credential URL</label><input class="form-control" type="url" name="CredentialUrl" value="@item.CredentialUrl"/></div><div class="form-field"><label>Certificate image URL</label><input class="form-control" name="CertificateImage" value="@item.CertificateImage"/></div><div class="form-field"><label>Organization logo URL</label><input class="form-control" name="OrganizationLogo" value="@item.OrganizationLogo"/></div><label class="form-check"><input type="checkbox" name="DoesNotExpire" value="true" checked="@item.DoesNotExpire"/><input type="hidden" name="DoesNotExpire" value="false"/> Does not expire</label><partial name="_OrderActiveFields" model="item"/></div><partial name="_FormActions"/></form>
