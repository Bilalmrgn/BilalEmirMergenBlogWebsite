@model BilalEmirMergenWebsite.Controllers.DashboardViewModel
@using BilalEmirMergenWebsite.Models
@using BilalEmirMergenWebsite.Controllers
@{ var item=Model.Services.FirstOrDefault(x=>x.Id==Model.EditId)??new Service(); }
<partial name="_AdminListHeader" model='("Services","Add service")'/>
<partial name="_OrderedTable" model='new OrderedTableViewModel("service",Model.Services.Select(x=>(x.Id,x.TitleEn,x.TitleTr,x.SortOrder,x.IsActive)))'/>
<form class="admin-form open localized-admin-form" method="post" action="/admin/service/save">
@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@(Model.EditId is null?"":item.Id)"/>
<div class="admin-locale-tabs"><button type="button" class="active" data-locale-tab="en">English</button><button type="button" data-locale-tab="tr">Türkçe</button><button type="button" data-locale-tab="ar">العربية</button></div>
<div class="form-grid"><div class="locale-pane active" data-locale-pane="en"><div class="form-field"><label>Title</label><input class="form-control" name="TitleEn" value="@item.TitleEn"/></div><div class="form-field"><label>Description</label><textarea class="form-control" name="DescriptionEn">@item.DescriptionEn</textarea></div></div><div class="locale-pane" data-locale-pane="tr"><div class="form-field"><label>Başlık</label><input class="form-control" name="TitleTr" value="@item.TitleTr"/></div><div class="form-field"><label>Açıklama</label><textarea class="form-control" name="DescriptionTr">@item.DescriptionTr</textarea></div></div><div class="locale-pane" data-locale-pane="ar" dir="rtl"><div class="form-field"><label>العنوان</label><input class="form-control" name="TitleAr" value="@item.TitleAr"/></div><div class="form-field"><label>الوصف</label><textarea class="form-control" name="DescriptionAr">@item.DescriptionAr</textarea></div></div><div class="form-field"><label>Lucide icon</label><input class="form-control icon-picker-input" name="Icon" value="@item.Icon" placeholder="braces"/></div><div class="form-field"><label>Accent color</label><input class="form-control" type="color" name="AccentColor" value="@item.AccentColor"/></div><partial name="_OrderActiveFields" model="item"/></div><partial name="_FormActions"/></form>
