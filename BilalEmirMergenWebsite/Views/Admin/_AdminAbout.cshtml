@model BilalEmirMergenWebsite.Controllers.DashboardViewModel
@{ var item = Model.AboutSections.FirstOrDefault(value => value.Id == Model.EditId) ?? new BilalEmirMergenWebsite.Models.AboutSection(); }
<div class="admin-panel-header"><div><p class="admin-eyebrow">Public section</p><h2>About</h2></div><a class="btn" href="/#about" target="_blank" rel="noreferrer"><i data-lucide="eye"></i>Preview</a></div>
<partial name="_OrderedTable" model='new BilalEmirMergenWebsite.Controllers.OrderedTableViewModel("about", Model.AboutSections.Select(value => (value.Id, value.TitleEn, value.EyebrowEn, value.SortOrder, value.IsActive)))' />
<form class="admin-editor admin-form open" method="post" action="/admin/about/save" enctype="multipart/form-data">
    @Html.AntiForgeryToken()<input type="hidden" name="Id" value="@(Model.EditId is null ? "" : item.Id)" /><input type="hidden" name="ImageUrl" value="@item.ImageUrl" /><input type="hidden" name="EyebrowTr" value="@item.EyebrowTr" /><input type="hidden" name="EyebrowAr" value="@item.EyebrowAr" /><input type="hidden" name="TitleTr" value="@item.TitleTr" /><input type="hidden" name="TitleAr" value="@item.TitleAr" /><input type="hidden" name="ShortTextTr" value="@item.ShortTextTr" /><input type="hidden" name="ShortTextAr" value="@item.ShortTextAr" /><input type="hidden" name="DescriptionTr" value="@item.DescriptionTr" /><input type="hidden" name="DescriptionAr" value="@item.DescriptionAr" />
    <div class="form-grid">
        <div class="form-field"><label>Eyebrow label</label><input class="form-control" name="EyebrowEn" value="@item.EyebrowEn" placeholder="WELCOME" /></div>
        <div class="form-field"><label>Section title</label><input class="form-control" name="TitleEn" value="@item.TitleEn" required /></div>
        <div class="form-field full"><label>Lead introduction</label><textarea class="form-control" name="ShortTextEn">@item.ShortTextEn</textarea></div>
        <partial name="_RichTextEditor" model='new BilalEmirMergenWebsite.Controllers.RichTextEditorViewModel("DescriptionEn", item.DescriptionEn, "About content", "Choose styles, typefaces, sizes, colors and alignment just like in a document editor.", "320px")' />
        <div class="form-field"><label>Section image</label><input class="form-control" type="file" name="imageFile" accept=".png,.jpg,.jpeg,.webp" data-image-input /></div>
        <partial name="_OrderActiveFields" model="item" />
    </div>
    <partial name="_FormActions" />
</form>
