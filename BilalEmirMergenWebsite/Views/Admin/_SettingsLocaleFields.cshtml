@model BilalEmirMergenWebsite.Controllers.SettingsLocaleViewModel
@{var s=Model.Settings;var x=Model.Suffix;string V(string n)=>(s.GetType().GetProperty(n+x)?.GetValue(s)?.ToString()??"");}
<div class="form-field"><label>Title</label><input class="form-control" name="Title@x" value="@V("Title")"/></div><div class="form-field"><label>Subtitle</label><input class="form-control" name="Subtitle@x" value="@V("Subtitle")"/></div><div class="form-field full"><label>Headline</label><input class="form-control" name="Headline@x" value="@V("Headline")"/></div><div class="form-field full"><label>Introduction</label><textarea class="form-control" name="Intro@x">@V("Intro")</textarea></div><div class="form-field"><label>Location</label><input class="form-control" name="Location@x" value="@V("Location")"/></div><div class="form-field"><label>Availability text</label><input class="form-control" name="Availability@x" value="@V("Availability")"/></div><div class="form-field"><label>Contact title</label><input class="form-control" name="ContactTitle@x" value="@V("ContactTitle")"/></div><div class="form-field"><label>SEO title</label><input class="form-control" name="SeoTitle@x" value="@V("SeoTitle")"/></div><div class="form-field full"><label>Contact text</label><textarea class="form-control" name="ContactText@x">@V("ContactText")</textarea></div><div class="form-field full"><label>SEO description</label><textarea class="form-control" name="SeoDescription@x">@V("SeoDescription")</textarea></div>
