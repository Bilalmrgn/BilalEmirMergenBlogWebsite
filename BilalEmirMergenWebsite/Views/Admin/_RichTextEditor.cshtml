@model BilalEmirMergenWebsite.Controllers.RichTextEditorViewModel
@{
    var editorId = $"rich-editor-{Model.Name.ToLowerInvariant()}";
}
<div class="form-field full rich-text-field">
    <label id="@editorId-label">@Model.Label</label>
    <div class="word-editor" data-rich-text-editor style="--editor-min-height:@Model.MinHeight">
        <div class="word-editor-toolbar" role="toolbar" aria-label="@Model.Label formatting controls">
            <label class="editor-select-label">
                <span class="visually-hidden">Text style</span>
                <select data-rte-block aria-label="Text style">
                    <option value="p">Paragraph</option>
                    <option value="h2">Heading 2</option>
                    <option value="h3">Heading 3</option>
                    <option value="blockquote">Quote</option>
                    <option value="pre">Code block</option>
                </select>
            </label>
            <label class="editor-select-label editor-font-select">
                <span class="visually-hidden">Typeface</span>
                <select data-rte-value-command="fontName" aria-label="Typeface">
                    <option value="Manrope">Modern Sans</option>
                    <option value="Bodoni Moda">Luxury Display</option>
                    <option value="Cormorant Garamond">Editorial Serif</option>
                    <option value="Georgia">Classic Serif</option>
                    <option value="Consolas">Monospace</option>
                </select>
            </label>
            <label class="editor-select-label editor-size-select">
                <span class="visually-hidden">Font size</span>
                <select data-rte-value-command="fontSize" aria-label="Font size">
                    <option value="2">Small</option>
                    <option value="3" selected>Normal</option>
                    <option value="4">Large</option>
                    <option value="5">Title</option>
                    <option value="6">Display</option>
                </select>
            </label>
            <span class="toolbar-divider" aria-hidden="true"></span>
            <button type="button" data-rte-command="bold" aria-label="Bold" title="Bold (Ctrl+B)"><i data-lucide="bold"></i></button>
            <button type="button" data-rte-command="italic" aria-label="Italic" title="Italic (Ctrl+I)"><i data-lucide="italic"></i></button>
            <button type="button" data-rte-command="underline" aria-label="Underline" title="Underline (Ctrl+U)"><i data-lucide="underline"></i></button>
            <button type="button" data-rte-command="strikeThrough" aria-label="Strikethrough" title="Strikethrough"><i data-lucide="strikethrough"></i></button>
            <span class="toolbar-divider" aria-hidden="true"></span>
            <label class="editor-color-control" title="Text color" style="--editor-color:#172033">
                <i data-lucide="palette"></i><span class="visually-hidden">Text color</span>
                <input type="color" value="#172033" data-rte-color="foreColor" aria-label="Text color" />
            </label>
            <label class="editor-color-control highlight" title="Highlight color" style="--editor-color:#FFF2A8">
                <i data-lucide="highlighter"></i><span class="visually-hidden">Highlight color</span>
                <input type="color" value="#FFF2A8" data-rte-color="hiliteColor" aria-label="Highlight color" />
            </label>
            <span class="toolbar-divider" aria-hidden="true"></span>
            <button type="button" data-rte-command="insertUnorderedList" aria-label="Bulleted list" title="Bulleted list"><i data-lucide="list"></i></button>
            <button type="button" data-rte-command="insertOrderedList" aria-label="Numbered list" title="Numbered list"><i data-lucide="list-ordered"></i></button>
            <button type="button" data-rte-command="outdent" aria-label="Decrease indent" title="Decrease indent"><i data-lucide="outdent"></i></button>
            <button type="button" data-rte-command="indent" aria-label="Increase indent" title="Increase indent"><i data-lucide="indent"></i></button>
            <span class="toolbar-divider" aria-hidden="true"></span>
            <button type="button" data-rte-command="justifyLeft" aria-label="Align left" title="Align left"><i data-lucide="align-left"></i></button>
            <button type="button" data-rte-command="justifyCenter" aria-label="Align center" title="Align center"><i data-lucide="align-center"></i></button>
            <button type="button" data-rte-command="justifyRight" aria-label="Align right" title="Align right"><i data-lucide="align-right"></i></button>
            <span class="toolbar-divider" aria-hidden="true"></span>
            <button type="button" data-rte-link aria-label="Add link" title="Add link"><i data-lucide="link"></i></button>
            <button type="button" data-rte-command="unlink" aria-label="Remove link" title="Remove link"><i data-lucide="link-2-off"></i></button>
            <button type="button" data-rte-command="removeFormat" aria-label="Clear formatting" title="Clear formatting"><i data-lucide="remove-formatting"></i></button>
            <span class="toolbar-spacer"></span>
            <button type="button" data-rte-command="undo" aria-label="Undo" title="Undo"><i data-lucide="undo-2"></i></button>
            <button type="button" data-rte-command="redo" aria-label="Redo" title="Redo"><i data-lucide="redo-2"></i></button>
        </div>
        <div id="@editorId" class="word-editor-surface article-prose" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="@editorId-label" data-rte-surface>@Html.Raw(Model.Value)</div>
        <textarea name="@Model.Name" data-rte-input hidden>@Model.Value</textarea>
        <div class="word-editor-footer"><span><i data-lucide="sparkles"></i>@Model.HelpText</span><span data-rte-word-count>0 words</span></div>
    </div>
</div>
